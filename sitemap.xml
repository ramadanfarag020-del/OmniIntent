// أضف هذا الجزء داخل الكود ليقوم روبوت جوجل بقراءة المحتوى المخصص لكل رابط في السيتامپ
if (isBot) {
    window.addEventListener('DOMContentLoaded', () => {
        let urlParams = new URLSearchParams(window.location.search);
        let q = urlParams.get('q') || '';
        if (q) {
            let decodedQ = decodeURIComponent(q).replace(/[\+\-_]/g, ' ');
            document.title = decodedQ.toUpperCase() + " | Global Sovereign Index 2026";
            const botDiv = document.getElementById('bot-content');
            if (botDiv) {
                botDiv.style.display = 'block';
                botDiv.innerHTML = `<h1>Verified Index for: ${decodedQ}</h1><p>Comprehensive decentralized market gateway, liquidity routing, and professional intelligence node for ${decodedQ} updated for 2026.</p>`;
            }
        }
    });
}
